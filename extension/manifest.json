{
  "manifest_version": 3,
  "name": "FinanceEcom Monitor",
  "version": "1.0.0",
  "description": "Salva e monitora anúncios de concorrentes do Mercado Livre direto no seu painel FinanceEcom.",
  "permissions": ["storage", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://produto.mercadolivre.com.br/*",
    "https://www.mercadolivre.com.br/*",
    "https://*.mercadolivre.com.br/*",
    "https://app.financeecom.com.br/*"
  ],
  "background": { "service_worker": "service-worker.js" },
  "content_scripts": [
    {
      "matches": [
        "https://produto.mercadolivre.com.br/*",
        "https://www.mercadolivre.com.br/*",
        "https://*.mercadolivre.com.br/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "FinanceEcom Monitor" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
