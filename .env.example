# ---------------------------------------------------------------------
# FinanceEcom Free - variaveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env real.
# ---------------------------------------------------------------------

# Porta do servidor Express
PORT=3000

# Supabase (Project Settings > API)
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=coloque-a-service-role-key-aqui

# Token para acessar o painel administrativo (/admin.html)
# Gere algo forte, ex.: openssl rand -hex 24
ADMIN_TOKEN=troque-este-token

# ---------------------------------------------------------------------
# Notificacao por e-mail de novo cliente (opcional)
# Para Gmail: crie uma "Senha de app" em myaccount.google.com/apppasswords
# (exige verificacao em 2 etapas ativada). Use-a em SMTP_PASS.
# ---------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=senha-de-app-de-16-digitos
NOTIFY_EMAIL=souzashopping.online@gmail.com
